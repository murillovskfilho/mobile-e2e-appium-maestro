{
  "name": "mobile-e2e-appium",
  "private": true,
  "description": "Appium 3 + WebdriverIO end-to-end suite for an Android shopping app",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "wdio run ./wdio.conf.ts",
    "test:smoke": "wdio run ./wdio.conf.ts --mochaOpts.grep @smoke",
    "typecheck": "tsc --noEmit",
    "report": "allure generate allure-results --clean -o allure-report"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "22.20.5",
    "@wdio/allure-reporter": "10.2.0",
    "@wdio/appium-service": "10.2.0",
    "@wdio/cli": "10.2.0",
    "@wdio/globals": "10.2.0",
    "@wdio/local-runner": "10.2.0",
    "@wdio/mocha-framework": "10.2.0",
    "@wdio/spec-reporter": "10.2.0",
    "allure-commandline": "2.46.1",
    "appium": "3.9.0",
    "appium-uiautomator2-driver": "8.7.3",
    "typescript": "5.9.3"
  }
}
